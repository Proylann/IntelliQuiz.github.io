<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/timer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1A1818"
    android:fillViewport="true"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <!-- Leaderboard Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins_black"
            android:text="Leaderboards"
            android:textColor="#F6F3F3"
            android:textSize="32sp"
            android:textStyle="bold"
            android:layout_marginBottom="20dp"/>

        <!-- Difficulty Navigation -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="20dp">

            <Button
                android:id="@+id/prevDifficulty"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:backgroundTint="#1919B4"
                android:text="Back"
                android:textColor="@android:color/white" />

            <TextView
                android:id="@+id/difficultyText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="20dp"
                android:layout_marginRight="20dp"
                android:fontFamily="@font/poppins_black"
                android:text="Easy"
                android:textColor="#F6F3F3"
                android:textSize="24sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/nextDifficulty"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:backgroundTint="#1919B4"
                android:text="Next"
                android:textColor="@android:color/white" />
        </LinearLayout>

        <!-- Headers for Username and Score -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="312dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/poppins_black"
                android:text="USERNAME"
                android:textColor="#F6F3F3"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_black"
                android:text="SCORE"
                android:textColor="#F6F3F3"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- User entries will be added dynamically -->
        <LinearLayout
            android:id="@+id/leaderboards"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp" />

        <ProgressBar
            android:id="@+id/progressBar"
            style="?android:attr/progressBarStyleLarge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="visible"
            android:layout_gravity="center" />

        <!-- Home Button -->
        <Button
            android:id="@+id/homeButton"
            android:layout_width="214dp"
            android:layout_height="60dp"
            android:layout_marginTop="24dp"
            android:backgroundTint="#CE2029"
            android:fontFamily="@font/poppins_black"
            android:padding="12dp"
            android:text="HOME"
            android:textAlignment="center"
            android:textColor="@android:color/white"
            android:textSize="20sp" />
    </LinearLayout>
</ScrollView>
